# ID de cliente OAuth de Google (tipo "Aplicación web"). Termina en .apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# Cadena larga aleatoria para firmar las sesiones (mínimo 16 caracteres). Si la cambias, todos tendrán que volver a entrar.
SESSION_SECRET=
# Los pone Vercel automáticamente al conectar Upstash for Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=
